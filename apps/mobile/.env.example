# Firebase WEB config for your company build. Copy to apps/mobile/.env.production (git-ignored) and fill in, or let
#   node scripts/fetch-firebase-config.mjs --project <your-firebase-project-id>
# write it for you. These values are public by design (every browser that opens your FreeField website downloads
# them), but keep the file out of Git anyway. Same names the FreeField web app uses.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Safety catch: must equal VITE_FIREBASE_PROJECT_ID, or the build stops.
VITE_EXPECTED_FIREBASE_PROJECT_ID=
# Only if your Cloud Functions are not in us-central1:
# VITE_FIREBASE_FUNCTIONS_REGION=
# Optional: overrides authLinkDomain from company.config.json.
# VITE_FF_AUTH_LINK_DOMAIN=
