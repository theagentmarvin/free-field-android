{
  "name": "@ffm/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "VITE_FF_DEMO_AUTH=true vite",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "VITE_FF_DEMO_AUTH=true vite build",
    "prebuild:e2e": "FFM_DEMO_MODELS=STRUCTURAL node scripts/prepare-assets.mjs",
    "prebuild:perf": "node scripts/prepare-assets.mjs",
    "build:perf": "VITE_FF_DEMO_AUTH=true VITE_FFM_TEST_HOOKS=true vite build",
    "cap:sync:perf": "pnpm build:perf && cap sync android",
    "android:debug:perf": "pnpm cap:sync:perf && cd android && ./gradlew assembleDebug",
    "build:e2e": "VITE_FF_DEMO_AUTH=true VITE_FFM_TEST_HOOKS=true vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --no-file-parallelism",
    "cap:sync": "pnpm build && cap sync android",
    "cap:sync:e2e": "pnpm build:e2e && cap sync android",
    "android:debug": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "android:debug:e2e": "pnpm cap:sync:e2e && cd android && ./gradlew assembleDebug",
    "build:emulator": "bash -c 'source scripts/emulator-env.sh && node scripts/prepare-assets.mjs && vite build'",
    "cap:sync:emulator": "pnpm build:emulator && bash -c 'source scripts/emulator-env.sh && cap sync android'",
    "android:debug:emulator": "pnpm cap:sync:emulator && cd android && bash -c 'source ../scripts/emulator-env.sh && ./gradlew assembleDebug'"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@ff/auth": "workspace:*",
    "@ff/data": "workspace:*",
    "@ff/firestore": "workspace:*",
    "@ff/sync": "workspace:*",
    "@ff/tasks": "workspace:*",
    "@ff/tasks-react": "workspace:*",
    "@ff/telemetry": "workspace:*",
    "@ff/types": "workspace:*",
    "@ff/viewer": "workspace:*",
    "@ff/viewer-react": "workspace:*",
    "@thatopen/components": "^3.6.0",
    "@thatopen/components-front": "^3.6.0",
    "@thatopen/fragments": "3.6.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "firebase": "^11.0.0",
    "iconoir-react": "^7.11.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "three": "^0.182.0",
    "web-ifc": "^0.0.77",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
