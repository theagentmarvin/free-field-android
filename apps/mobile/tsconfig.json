{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "capacitor.config.ts",
    "../../vendor/free-field/packages/ff-auth/src/env.d.ts",
    "../../vendor/free-field/packages/ff-viewer/src/types/vite-assets.d.ts",
    "../../vendor/free-field/packages/ff-viewer-react/src/types/vite-assets.d.ts"
  ]
}
