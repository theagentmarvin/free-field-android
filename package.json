{
  "name": "free-field-mobile",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.1",
  "description": "FreeField Mobile workspace root (apps/mobile + vendored @ff/* packages).",
  "scripts": {
    "dev": "pnpm --filter @ffm/mobile dev",
    "build": "pnpm --filter @ffm/mobile build",
    "typecheck": "pnpm --filter @ffm/mobile typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm --filter @ffm/mobile lint",
    "test": "pnpm --filter @ffm/mobile test",
    "android:debug": "pnpm --filter @ffm/mobile android:debug",
    "android:debug:e2e": "pnpm --filter @ffm/mobile android:debug:e2e",
    "e2e": "bash scripts/e2e.sh",
    "check:singletons": "node scripts/check-singletons.mjs",
    "e2e:emulator": "bash scripts/e2e-emulator.sh",
    "check:release": "flock -o /tmp/ffm-heavy.lock timeout -k 30 900 node scripts/check-release-bundle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "playwright-core": "1.52.0",
    "typescript": "5.6.3"
  }
}
